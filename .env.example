# Copia este archivo a .env.local y rellena los valores.
# Todos los de esta primera seccion son obligatorios: sin ellos la app no arranca
# y /api/health/readiness responde 503.

# --- Supabase -----------------------------------------------------------------
# Project settings > API en el panel de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor. NUNCA la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifrado de integraciones -------------------------------------------------
# Llave maestra con la que se cifran las API keys de cada empresa (AES-256-GCM).
# Generala con: openssl rand -base64 32
# Si la cambias, los secretos ya guardados dejan de poder descifrarse.
INTEGRATION_ENCRYPTION_KEY=

# --- Crons y webhooks ---------------------------------------------------------
# Protege /api/cron/* y /api/health/*. Vercel lo manda solo en sus crons.
# Generalo con: openssl rand -hex 32
CRON_SECRET=

# Dominio publico de la app. Se usa para las URLs de webhook que ve el cliente y
# para el enlace de recuperacion de contraseña. Sin barra final.
NEXT_PUBLIC_APP_URL=https://tudominio.com

# --- Superadmins --------------------------------------------------------------
# Correos separados por coma que entran a /admin sin pertenecer a un workspace.
SUPERADMIN_EMAILS=admin@tudominio.com

# --- Alta automática tras pagar Levy (opcional) -------------------------------
# El workflow "Crear cuenta" del funnel de la agencia llama a
# /api/webhooks/ghl/purchase con "Authorization: Bearer <este secreto>".
# Generalo con: openssl rand -hex 32
LEVY_PURCHASE_WEBHOOK_SECRET=
# GoHighLevel de la AGENCIA (donde se vende Levy), no el de cada cliente.
# Private Integration con View Contacts, Edit Contacts y View Custom Fields.
GHL_AGENCY_TOKEN=
GHL_AGENCY_LOCATION_ID=

# Calendario de la reunión de puesta en marcha (paso 3 del onboarding).
# Es un calendario propio del onboarding, distinto del que AAA001 usa con sus
# clientes, así que el id se pone siempre. El token y la location solo hacen
# falta si ese calendario vive en otra subcuenta de GoHighLevel; si no, se
# heredan de GHL_AGENCY_* y, en su defecto, de la conexión guardada de AAA001.
LEVY_MEETING_CALENDAR_ID=
# El token necesita scopes de calendario (View Calendars, View/Edit Calendar
# Events) además de contactos: GHL_AGENCY_TOKEN normalmente no los trae.
LEVY_MEETING_GHL_TOKEN=
LEVY_MEETING_GHL_LOCATION_ID=
