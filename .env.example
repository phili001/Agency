# Copia este archivo a .env.local y rellena los valores.
# Todos los de esta primera seccion son obligatorios: sin ellos la app no arranca
# y /api/health/readiness responde 503.

# --- Supabase -----------------------------------------------------------------
# Project settings > API en el panel de Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: solo servidor. NUNCA la expongas con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cifrado de integraciones -------------------------------------------------
# Llave maestra con la que se cifran las API keys de cada empresa (AES-256-GCM).
# Generala con: openssl rand -base64 32
# Si la cambias, los secretos ya guardados dejan de poder descifrarse.
INTEGRATION_ENCRYPTION_KEY=

# --- Crons y webhooks ---------------------------------------------------------
# Protege /api/cron/* y /api/health/*. Vercel lo manda solo en sus crons.
# Generalo con: openssl rand -hex 32
CRON_SECRET=

# Dominio publico de la app. Se usa para las URLs de webhook que ve el cliente y
# para el enlace de recuperacion de contraseña. Sin barra final.
NEXT_PUBLIC_APP_URL=https://tudominio.com

# --- Superadmins --------------------------------------------------------------
# Correos separados por coma que entran a /admin sin pertenecer a un workspace.
SUPERADMIN_EMAILS=admin@tudominio.com

# --- Google Calendar (CRM y Agenda) ---------------------------------------------
# Credenciales OAuth de la app ("Aplicación web") en Google Cloud, con Google
# Calendar API activada. Cada empresa conecta SU calendario desde Integraciones;
# los tokens de cada una se guardan cifrados, no aquí.
# URI de redirección: {NEXT_PUBLIC_APP_URL}/api/integrations/google-calendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Venta de Levy con Stripe (Payment Link externo) ---------------------------
# Clave secreta de la cuenta de Stripe (sk_test_... en pruebas). Solo servidor.
STRIPE_SECRET_KEY=
# Secreto de firma del endpoint {NEXT_PUBLIC_APP_URL}/api/webhooks/stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Ids de los Payment Links de Levy (plink_...), separados por coma. Un pago de
# otro enlace o producto se ignora.
STRIPE_PAYMENT_LINK_IDS=
# URL pública del Payment Link de Levy (https://buy.stripe.com/...). El botón
# «Pagar / reactivar» del panel la abre con la empresa y el correo del dueño.
STRIPE_PAYMENT_LINK_URL=
# Ids de los precios de Levy (price_...), separados por coma.
STRIPE_PRICE_IDS=
# Clave del campo personalizado del Payment Link con el nombre del negocio.
STRIPE_FIELD_COMPANY_NAME=nombredelnegocio
# Días con el servicio activo tras un impago antes de pausar la IA.
BILLING_GRACE_DAYS=7

# --- Correo de la plataforma (Gmail) -------------------------------------------
# Un solo Gmail de Levy: envía el correo de acceso tras pagar y los avisos de la
# reunión. Usa una cuenta dedicada con verificación en dos pasos: la contraseña de
# aplicación da acceso a todo ese buzón. No es el Google de ninguna empresa.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- CRM de Levy ---------------------------------------------------------------
# Empresa cuyo CRM guarda a los clientes de Levy (por defecto AAA001).
LEVY_WORKSPACE_CODE=AAA001
# Agenda de AAA001 para la reunión de puesta en marcha (paso 3 del onboarding).
# Sin ella, el paso no ofrece horas y muestra el contacto de soporte.
LEVY_MEETING_AGENDA_ID=
